# ==============================================================================
# DIGITAL MINE SAFETY OFFICER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in both project root and backend directory:
#   cp .env.example .env
#   cp .env.example backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini API Key used for:
#   - Multimodal Vision Hazard Inspector (Gemini 2.5 Flash Vision)
#   - Agentic AI Tool Calling & Autonomous Safety Orchestration
#   - RAG Regulatory QA against Coal Mines Regulations (CMR 2017)
# Get a key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVER CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
# Host interface for the FastAPI server (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# Port on which FastAPI runs (Default 7860 aligns with HuggingFace Space / Docker)
PORT=7860

# Local SQLite Cache Path for L2 query and RAG response memoization
DB_PATH=rag_cache.db

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (Vite + React)
# ------------------------------------------------------------------------------
# Base URL of the local FastAPI backend
VITE_BACKEND_URL=http://localhost:7860

# Cloud fallback URL for cloud demo or when local backend is starting
VITE_FALLBACK_BACKEND_URL=https://krishnasimha-mine-agent.hf.space
